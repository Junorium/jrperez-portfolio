<header class="masthead">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="20" fill="#F6F4EC"/>
        <circle cx="20" cy="20" r="12" fill="none" stroke="#1B4D3E" stroke-width="5" stroke-dasharray="2.36 2.36"/>
        <circle cx="20" cy="20" r="10" fill="#1B4D3E"/>
        <circle cx="20" cy="20" r="3.5" fill="#F6F4EC"/>
      </svg>
      JR Perez
    </a>
    <nav class="nav" aria-label="Main">
      {%- for item in nav %}
        {%- if item.external %}
      <a href="{{ item.href }}" target="_blank" rel="noopener">{{ item.label }}</a>
        {%- else %}
      <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endif %}
      {%- endfor %}
    </nav>
  </div>
</header>
