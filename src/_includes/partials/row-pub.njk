<li class="pub">
  <article>
    {% set href = item | itemHref %}
    <h3>
      {% if href %}
        <a href="{{ href }}"{% if href | isExternalHref %} rel="noopener"{% endif %}>{{ item.data.title }}</a>
      {% else %}
        {{ item.data.title }}
      {% endif %}
    </h3>
    {% if item.data.doi %}
      <p class="venue">{{ item.data.description }} <a href="https://doi.org/{{ item.data.doi }}" rel="noopener">DOI {{ item.data.doi }}</a></p>
    {% elif item.data.venue %}
      <p>{{ item.data.venue }}. {{ item.data.description }}</p>
    {% else %}
      <p>{{ item.data.description }}</p>
    {% endif %}
  </article>
  {% set status = item.data.status %}
  {% include "partials/tag.njk" %}
</li>
